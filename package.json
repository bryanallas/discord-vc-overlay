{
  "name": "discord-vc-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A transparent desktop voice chat overlay connected to Discord desktop.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.discordvcoverlay.app",
    "productName": "Discord VC Overlay",
    "mac": {
      "icon": "resources/app-icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/app-icon.svg",
      "resources/app-icon.ico",
      "resources/app-icon.icns"
    ],
    "publish": {
      "provider": "github",
      "owner": "bryanallas",
      "repo": "discord-vc-overlay",
      "releaseType": "release"
    }
  }
}
